{
  "name": "cw-website",
  "version": "1.0.0",
  "description": "Personal portfolio website for Ash Crockett, full-stack software engineer.",
  "main": "index.js",
  "scripts": {
    "start": "webpack serve --mode development",
    "build": "webpack --mode production",
    "serve:e2e": "serve dist --single --listen tcp://127.0.0.1:4173 --no-port-switching --no-clipboard",
    "lint": "eslint src/ e2e/ .devin/vitest.config.mts .devin/playwright.config.ts",
    "lint:fix": "eslint src/ e2e/ .devin/vitest.config.mts .devin/playwright.config.ts --fix",
    "format": "prettier \"src/**/*.{ts,tsx}\" \"e2e/**/*.ts\" .devin/vitest.config.mts .devin/tsconfig.test.json .devin/playwright.config.ts .devin/tsconfig.e2e.json --write",
    "format:check": "prettier \"src/**/*.{ts,tsx}\" \"e2e/**/*.ts\" .devin/vitest.config.mts .devin/tsconfig.test.json .devin/playwright.config.ts .devin/tsconfig.e2e.json --check",
    "test": "vitest run --config .devin/vitest.config.mts",
    "test:watch": "vitest --config .devin/vitest.config.mts",
    "test:coverage": "vitest run --coverage --config .devin/vitest.config.mts",
    "test:e2e": "playwright test --config .devin/playwright.config.ts",
    "test:e2e:ui": "playwright test --config .devin/playwright.config.ts --ui",
    "test:e2e:debug": "playwright test --config .devin/playwright.config.ts --debug",
    "test:e2e:report": "playwright show-report playwright-report",
    "test:e2e:update": "playwright test --config .devin/playwright.config.ts --project=chromium --project=mobile-chromium --update-snapshots=all e2e/visual.spec.ts",
    "e2e": "npm run build && npm run test:e2e",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p .devin/tsconfig.test.json && tsc --noEmit -p .devin/tsconfig.e2e.json",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test:coverage && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ash-c/cw-website.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/ash-c/cw-website/issues"
  },
  "homepage": "https://github.com/ash-c/cw-website#readme",
  "dependencies": {
    "@chakra-ui/icons": "^2.2.6",
    "@chakra-ui/react": "^3.38.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.65.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/node": "24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/webpack-env": "^1.18.8",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "html-webpack-plugin": "^5.6.8",
    "jsdom": "29.1.1",
    "prettier": "^3.10.1",
    "serve": "14.2.8",
    "ts-loader": "^9.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "4.1.12",
    "webpack": "^5.113.0",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.7"
  },
  "overrides": {
    "@axe-core/playwright": {
      "axe-core": "4.14.0"
    }
  }
}
